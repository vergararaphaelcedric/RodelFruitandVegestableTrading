{
  "name": "requisition-system-frontend",
  "private": true,
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "build:css": "tailwindcss -i ./static/src/tailwind.css -o ./static/css/tailwind.build.css --minify",
    "watch:css": "tailwindcss -i ./static/src/tailwind.css -o ./static/css/tailwind.build.css --watch",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "bootstrap": "5.3.3",
    "bootstrap-icons": "1.11.3",
    "tailwindcss": "3.4.17"
  }
}